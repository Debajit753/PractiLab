{
  "name": "practilab",
  "private": true,
  "version": "0.3.0",
  "description": "Virtual lab for engineering practicals: realistic BEEE trainer kits, live circuit simulation and a breadboard sandbox.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
